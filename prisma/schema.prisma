generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Only meaningful when DATABASE_URL points at a connection pooler (e.g. Supabase's pgbouncer
  // pooler) -- migrations need a direct, non-pooled connection. Harmless to leave unset for
  // local dev (plain docker-compose Postgres, no pooler in front of it).
  directUrl = env("DIRECT_URL")
}

model Salon {
  id                   String   @id @default(uuid())
  name                 String
  slug                 String   @unique
  logoUrl              String?
  brandColor           String   @default("#111111")
  stampsRequired       Int      @default(10)
  rewardDescription    String   @default("10 EUR Rabatt")
  trialEndsAt          DateTime
  subscriptionStatus   String   @default("trial") // "trial" | "active" | "canceled"
  // Manual kill switch, independent of Stripe -- set by the platform owner via /superadmin.
  // Staff/owner logins and salon-scoped API calls are blocked while false.
  isActive             Boolean  @default(true)
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  // Days of inactivity (no stamp) before a customer gets a "come back" reminder push.
  // null = reminders disabled for this salon (default: off, salon opts in via settings).
  reminderIntervalDays Int?
  // Salon's physical location, used for Google Wallet's native "relevant locations" feature --
  // the OS surfaces the pass on the lock screen when the customer is nearby, entirely handled
  // by Google/Apple, no push infrastructure of ours involved. null = feature unused.
  locationLat          Float?
  locationLng          Float?
  createdAt            DateTime @default(now())

  staffUsers   StaffUser[]
  customers    Customer[]
  loyaltyCards LoyaltyCard[]

  @@map("salons")
}

model StaffUser {
  id           String   @id @default(uuid())
  salonId      String
  email        String
  passwordHash String
  role         String   @default("staff") // "owner" | "staff"
  createdAt    DateTime @default(now())

  salon       Salon        @relation(fields: [salonId], references: [id])
  stampEvents StampEvent[]
  redemptions Redemption[]

  @@unique([salonId, email])
  @@map("staff_users")
}

model Customer {
  id        String   @id @default(uuid())
  salonId   String
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  salon        Salon         @relation(fields: [salonId], references: [id])
  loyaltyCards LoyaltyCard[]

  @@map("customers")
}

enum WalletMode {
  pwa
  apple
  google
}

model LoyaltyCard {
  id                 String     @id @default(uuid())
  customerId         String
  salonId            String
  serialNumber       String     @unique
  stampCount         Int        @default(0)
  walletMode         WalletMode @default(pwa)
  appleAuthToken     String?
  googleObjectId     String?
  // Tracks the last "come back" reminder push so a customer isn't re-notified every time the
  // salon's reminder job runs -- only null or older than reminderIntervalDays counts as due.
  lastReminderSentAt DateTime?
  createdAt          DateTime   @default(now())

  customer          Customer           @relation(fields: [customerId], references: [id])
  salon             Salon              @relation(fields: [salonId], references: [id])
  stampEvents       StampEvent[]
  redemptions       Redemption[]
  pushSubscriptions PushSubscription[]

  @@index([salonId])
  @@map("loyalty_cards")
}

model PushSubscription {
  id            String   @id @default(uuid())
  loyaltyCardId String
  endpoint      String   @unique
  p256dhKey     String
  authKey       String
  createdAt     DateTime @default(now())

  loyaltyCard LoyaltyCard @relation(fields: [loyaltyCardId], references: [id])

  @@map("push_subscriptions")
}

model StampEvent {
  id            String   @id @default(uuid())
  loyaltyCardId String
  staffUserId   String
  createdAt     DateTime @default(now())

  loyaltyCard LoyaltyCard @relation(fields: [loyaltyCardId], references: [id])
  staffUser   StaffUser   @relation(fields: [staffUserId], references: [id])

  @@map("stamp_events")
}

model Redemption {
  id            String   @id @default(uuid())
  loyaltyCardId String
  staffUserId   String
  redeemedAt    DateTime @default(now())

  loyaltyCard LoyaltyCard @relation(fields: [loyaltyCardId], references: [id])
  staffUser   StaffUser   @relation(fields: [staffUserId], references: [id])

  @@map("redemptions")
}

model RegisteredDevice {
  id                      String @id @default(uuid())
  deviceLibraryIdentifier String
  passTypeId              String
  serialNumber            String
  pushToken               String

  @@unique([deviceLibraryIdentifier, serialNumber])
  @@map("registered_devices")
}
