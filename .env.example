# Lokale Postgres-Instanz (siehe docker-compose.yml). Port 55432, nicht der
# Postgres-Standardport 5432 -- vermeidet Kollision mit einer eventuell
# bereits lokal laufenden, projektfremden Postgres-Installation.
DATABASE_URL="postgresql://stampcard:stampcard@localhost:55432/stampcard?schema=public"
# DIRECT_URL: only meaningful in production behind a connection pooler (e.g. Supabase's
# pgbouncer pooler) -- migrations need a direct, non-pooled connection. Locally, same value as
# DATABASE_URL is fine.
DIRECT_URL="postgresql://stampcard:stampcard@localhost:55432/stampcard?schema=public"

PORT=3000

# --- Apple Wallet (PassKit) ---
# Voraussetzung: Apple Developer Program Mitgliedschaft (99 USD/Jahr).
# Pass Type ID Zertifikat + privater Schluessel aus dem Apple Developer Portal.
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_CERT_PATH=       # Pfad zum .pem Zertifikat
APPLE_PASS_KEY_PATH=        # Pfad zum privaten Schluessel
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT_PATH=       # Apple WWDR Zwischenzertifikat
APNS_KEY_PATH=              # .p8 Key fuer Push-Updates an installierte Passes

# --- Google Wallet ---
# Voraussetzung: Google Wallet Issuer Account (Google Business Console).
GOOGLE_WALLET_ISSUER_ID=
# Credential-Dateien (Service-Account-JSON, Apple-Zertifikate) gehoeren nach secrets/,
# das ist per .gitignore ausgeschlossen -- niemals Secrets direkt im Projekt-Root ablegen.
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=secrets/google-wallet-service-account.json

# --- Auth ---
SESSION_SECRET=change-me-in-production

# --- Super-Admin (/superadmin -- Salons pausieren/aktivieren, unabhaengig von Stripe) ---
# Bcrypt-Hash des Super-Admin-Passworts, NICHT das Passwort selbst. Erzeugen mit:
#   node -e "require('bcrypt').hash('DEIN-PASSWORT', 12).then(console.log)"
SUPERADMIN_PASSWORD_HASH=

# --- Billing (Stripe) ---
# Voraussetzung: Stripe-Account (Test-Modus reicht zum Entwickeln, keine Firma noetig).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs (aus dem Stripe-Dashboard, Test-Modus), nicht die Betraege selbst --
# siehe src/billing/plans.ts.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STANDARD=

# --- Lokaler HTTPS-Dev-Modus (optional) ---
# Nur zum Testen von Browser-Features, die einen "Secure Context" verlangen (z.B. Kamera-Zugriff
# fuers Scannen vom Handy im WLAN) -- ein http://<lan-ip> Link reicht dafuer nicht.
# Selbstsigniertes Zertifikat erzeugen: siehe README. Niemals in Produktion verwenden.
DEV_HTTPS_CERT_PATH=
DEV_HTTPS_KEY_PATH=

# --- Web Push (Kunden-Erinnerungen) ---
# Kein externer Account noetig -- eigenes Schluesselpaar, einmalig erzeugen mit:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PUBLIC_KEY ist nicht geheim (geht an den Browser), VAPID_PRIVATE_KEY schon.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
